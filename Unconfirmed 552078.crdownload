#!/usr/bin/env python3
"""Generate purple-themed GitHub stat cards (stats / languages / streak) as SVGs.

Runs in GitHub Actions with GITHUB_TOKEN. Standard library only.
Outputs: assets/stats.svg, assets/langs.svg, assets/streak.svg
If the API is unreachable, placeholder cards are written instead.
"""
import datetime as dt
import json
import os
import sys
import urllib.request
from html import escape

USER = os.environ.get("GH_USER", "gyxnova")
TOKEN = os.environ.get("GITHUB_TOKEN", "")
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "assets")

FONT = "Segoe UI,Helvetica,Arial,sans-serif"
PALETTE = ["#8B5CF6", "#A78BFA", "#C084FC", "#6366F1", "#38BDF8"]

QUERY = """
query($login:String!){
  user(login:$login){
    followers{totalCount}
    pullRequests{totalCount}
    issues{totalCount}
    repositories(ownerAffiliations:OWNER,isFork:false,first:100,privacy:PUBLIC){
      totalCount
      nodes{
        stargazerCount
        languages(first:10,orderBy:{field:SIZE,direction:DESC}){edges{size node{name}}}
      }
    }
    contributionsCollection{
      totalCommitContributions
      contributionCalendar{
        totalContributions
        weeks{contributionDays{date contributionCount}}
      }
    }
  }
}
"""


def fetch():
    body = json.dumps({"query": QUERY, "variables": {"login": USER}}).encode()
    req = urllib.request.Request(
        "https://api.github.com/graphql",
        data=body,
        headers={"Authorization": f"bearer {TOKEN}", "User-Agent": "profile-stats"},
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        payload = json.load(r)
    if "errors" in payload or not payload.get("data", {}).get("user"):
        raise RuntimeError(payload.get("errors", "no user data"))
    return payload["data"]["user"]


def summarize(u):
    repos = u["repositories"]["nodes"]
    langs = {}
    for r in repos:
        for e in r["languages"]["edges"]:
            langs[e["node"]["name"]] = langs.get(e["node"]["name"], 0) + e["size"]
    total = sum(langs.values()) or 1
    top = sorted(langs.items(), key=lambda kv: -kv[1])[:5]
    top = [(n, s / total * 100) for n, s in top]

    cal = u["contributionsCollection"]["contributionCalendar"]
    days = [d for w in cal["weeks"] for d in w["contributionDays"]]
    today = dt.date.today().isoformat()
    days = [d for d in days if d["date"] <= today]
    longest = run = 0
    for d in days:
        run = run + 1 if d["contributionCount"] > 0 else 0
        longest = max(longest, run)
    current = 0
    for d in reversed(days):
        if d["contributionCount"] > 0:
            current += 1
        elif d["date"] == today:
            continue  # today not over yet
        else:
            break

    return {
        "commits": u["contributionsCollection"]["totalCommitContributions"],
        "repos": u["repositories"]["totalCount"],
        "stars": sum(r["stargazerCount"] for r in repos),
        "prs": u["pullRequests"]["totalCount"],
        "followers": u["followers"]["totalCount"],
        "langs": top,
        "contribs": cal["totalContributions"],
        "current": current,
        "longest": longest,
    }


# ---------- SVG rendering ----------
DEFS = """<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="#150F2E"/><stop offset="1" stop-color="#0B0818"/></linearGradient></defs>"""


def card(w, h, title, icon, inner):
    return f"""<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" viewBox="0 0 {w} {h}">
{DEFS}
<rect x="1" y="1" width="{w-2}" height="{h-2}" rx="14" fill="url(#g)" stroke="#5B3FD0" stroke-opacity="0.7"/>
<text x="24" y="38" font-family="{FONT}" font-size="16" fill="#A78BFA">{escape(icon)}</text>
<text x="56" y="38" font-family="{FONT}" font-size="18" font-weight="600" fill="#E9E3FF">{escape(title)}</text>
{inner}
</svg>"""


def fmt(v):
    return "—" if v is None else f"{v:,}"


def stats_svg(d):
    rows = [
        ("Commits (last year)", d and d["commits"]),
        ("Public repositories", d and d["repos"]),
        ("Stars earned", d and d["stars"]),
        ("Pull requests", d and d["prs"]),
        ("Followers", d and d["followers"]),
    ]
    inner = ""
    for i, (label, val) in enumerate(rows):
        y = 70 + i * 22
        inner += (
            f'<text x="26" y="{y}" font-family="{FONT}" font-size="14" fill="#B8B0D6">{label}</text>'
            f'<text x="394" y="{y}" text-anchor="end" font-family="{FONT}" font-size="14" font-weight="600" fill="#E9E3FF">{fmt(val)}</text>'
        )
    return card(420, 188, "GitHub Stats", "▮▮", inner)


def langs_svg(d):
    inner = ""
    langs = d["langs"] if d else []
    if not langs:
        inner = f'<text x="26" y="80" font-family="{FONT}" font-size="14" fill="#B8B0D6">Waiting for first update…</text>'
    for i, (name, pct) in enumerate(langs):
        y = 62 + i * 25
        color = PALETTE[i % len(PALETTE)]
        bar = max(4, 200 * pct / 100)
        inner += (
            f'<text x="26" y="{y+11}" font-family="{FONT}" font-size="13" fill="#E9E3FF">{escape(name)}</text>'
            f'<rect x="152" y="{y}" width="200" height="10" rx="5" fill="#241A4A"/>'
            f'<rect x="152" y="{y}" width="{bar:.1f}" height="10" rx="5" fill="{color}"/>'
            f'<text x="394" y="{y+10}" text-anchor="end" font-family="{FONT}" font-size="12" fill="#B8B0D6">{pct:.1f}%</text>'
        )
    return card(420, 188, "Top Languages", "</>", inner)


def streak_svg(d):
    cols = [
        ("Contributions (last year)", d and d["contribs"], 150),
        ("Current streak", d and d["current"], 430),
        ("Longest streak", d and d["longest"], 710),
    ]
    inner = ""
    for label, val, cx in cols:
        inner += (
            f'<text x="{cx}" y="95" text-anchor="middle" font-family="{FONT}" font-size="34" font-weight="700" fill="#C084FC">{fmt(val)}</text>'
            f'<text x="{cx}" y="122" text-anchor="middle" font-family="{FONT}" font-size="13" fill="#B8B0D6">{label}</text>'
        )
    inner += '<line x1="290" y1="62" x2="290" y2="124" stroke="#5B3FD0" stroke-opacity="0.5"/>'
    inner += '<line x1="570" y1="62" x2="570" y2="124" stroke="#5B3FD0" stroke-opacity="0.5"/>'
    return card(860, 150, "Contribution Streak", "⚡", inner)


def write(name, text):
    os.makedirs(OUT, exist_ok=True)
    with open(os.path.join(OUT, name), "w", encoding="utf-8") as f:
        f.write(text)


def main():
    data = None
    if os.environ.get("STATS_MOCK"):  # layout testing only
        data = {"commits": 1234, "repos": 20, "stars": 42, "prs": 18, "followers": 100,
                "langs": [("Python", 62.4), ("Jupyter Notebook", 21.0), ("HTML", 8.3), ("SQL", 5.1), ("Shell", 3.2)],
                "contribs": 1180, "current": 12, "longest": 47}
    else:
        try:
            data = summarize(fetch())
        except Exception as e:  # keep existing cards if they exist
            print(f"warning: could not fetch stats: {e}", file=sys.stderr)
            if all(os.path.exists(os.path.join(OUT, n)) for n in ("stats.svg", "langs.svg", "streak.svg")):
                return
    write("stats.svg", stats_svg(data))
    write("langs.svg", langs_svg(data))
    write("streak.svg", streak_svg(data))


if __name__ == "__main__":
    main()
